{
  "name": "opendart-python-conventions",
  "interface": {
    "displayName": "OpenDart Python Conventions"
  },
  "plugins": [
    {
      "name": "python-settings",
      "source": {
        "source": "local",
        "path": "./.agents/plugins/python-conventions/python-settings"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "python-http",
      "source": {
        "source": "local",
        "path": "./.agents/plugins/python-conventions/python-http"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "python-db",
      "source": {
        "source": "local",
        "path": "./.agents/plugins/python-conventions/python-db"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
