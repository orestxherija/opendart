set working-directory := '../..'

default:
    @just --justfile '{{ source_file() }}' --list

# Preview the CI checks that a change selects; an empty head compares the working tree.
plan base='origin/main' head='' event='pull_request':
    uv run --no-sync python scripts/ci/select_components.py --event {{ event }} --base {{ quote(base) }} --head {{ quote(head) }}

# Test CI change selection and the tool pins that must match.
test:
    uv run --no-sync pytest scripts/ci/tests --no-cov --html=.cache/pytest/ci-report.html -o cache_dir=.cache/pytest/ci
