# Copy to .env for direnv, or load explicitly with Settings(_env_file=".env").
OPENDART_API__API_KEY=replace-with-your-issued-40-character-key

# Local MCP HTTP listener. Compose publishes this port on 127.0.0.1 only.
OPENDART_MCP_HTTP__HOST=127.0.0.1
OPENDART_MCP_HTTP__PORT=8000

# Optional Compose secrets overlay: an absolute host file containing only the API key.
# OPENDART_API_KEY_FILE=/absolute/path/to/opendart-api-key
