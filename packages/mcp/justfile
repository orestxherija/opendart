# Use the shared workspace configuration, including when invoked as a module.
set working-directory := '../..'

scripts := 'scripts/check_mcp.py scripts/check_mcp_runtime.py scripts/check_mcp_components.py scripts/check_mcp_conformance.py'

# List available commands.
default:
    @just --justfile '{{ source_file() }}' --list

# Check lint and formatting.
lint:
    uv run --no-sync ruff check packages/mcp {{ scripts }}
    uv run --no-sync ruff format --check packages/mcp {{ scripts }}

# Format Python files.
format:
    uv run --no-sync ruff format packages/mcp {{ scripts }}

# Check types.
typecheck:
    uv run --no-sync pyrefly check --config pyrefly.toml packages/mcp/src

# Run MCP tests and collect package coverage.
test:
    uv run --no-sync prek run pytest-mcp --all-files --stage pre-push

# Lint the Dockerfile with Hadolint; needs Docker.
dockerfile:
    uv run --no-sync prek run hadolint-docker --all-files --stage pre-push

# Check component versions, definition fingerprints, and the tool token budget against the lock.
components:
    uv run --no-sync python scripts/check_mcp_components.py

# Validate the Compose configuration.
compose:
    docker compose -f packages/mcp/docker-compose.yml config --quiet

# Check the MCP package and the component lock.
check: lint typecheck test components

# Record intended component changes in the lock; pass --accept-changes after review, and for the first lock.
lock *args:
    uv run --no-sync python scripts/check_mcp_components.py --update {{ args }}

# Smoke-test an isolated native server over HTTP.
smoke:
    uv run --no-sync python scripts/check_mcp.py

# Run the official MCP conformance suite in both protocol eras; needs Node.js. Pass --scenario NAME for one.
conformance *args:
    uv run --no-sync python scripts/check_mcp_conformance.py {{ args }}

# Build the Python package.
build:
    uv build --package opendart-mcp

# Start the local MCP server.
run:
    uv run --no-sync opendart-mcp
