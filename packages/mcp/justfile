# Use the shared workspace configuration, including when invoked as a module.
set working-directory := '../..'

# List available commands.
default:
    @just --justfile '{{ source_file() }}' --list

# Check lint and formatting.
lint:
    uv run --no-sync ruff check packages/mcp scripts/check_mcp.py
    uv run --no-sync ruff format --check packages/mcp scripts/check_mcp.py

# Format Python files.
format:
    uv run --no-sync ruff format packages/mcp scripts/check_mcp.py

# Check types.
typecheck:
    uv run --no-sync mypy packages/mcp/src

# Run MCP tests without SDK coverage settings.
test:
    uv run --no-sync pytest packages/mcp/tests --no-cov

# Check the MCP package.
check: lint typecheck test

# Build the Python package.
build:
    uv build --package opendart-mcp

# Start the local MCP server.
run:
    uv run --no-sync opendart-mcp
