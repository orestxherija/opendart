        <mxCell id="title" value="OpenDART MCP · server design" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=27;fillColor=none;strokeColor=none;align=left;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="22" width="1072" height="38" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="packages/mcp · import opendart_mcp · FastMCP 4.1 · Python 3.14+ · depends on opendart-sdk and opendart-analysis" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#475569;strokeWidth=1.5;spacing=12;fontSize=15;fillColor=none;strokeColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="68" width="1072" height="26" as="geometry" /></mxCell>
        <mxCell id="runtime" value="RUNTIME · one request from an MCP client to OpenDART" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=15;fillColor=#eff6ff;strokeColor=#93c5fd;shape=swimlane;startSize=36;horizontal=1;align=left;spacingLeft=16;fontStyle=1;collapsible=0;pointerEvents=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="24" y="110" width="1072" height="918" as="geometry" /></mxCell>
        <mxCell id="server" value="FastMCP(&quot;OpenDART&quot;) · opendart_mcp/server.py" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=15;fillColor=#dbeafe;strokeColor=#60a5fa;shape=swimlane;startSize=36;horizontal=1;align=left;spacingLeft=16;fontStyle=1;collapsible=0;pointerEvents=0;swimlaneFillColor=#ffffff;" vertex="1" parent="runtime"><mxGeometry x="24" y="160" width="664" height="278" as="geometry" /></mxCell>
        <mxCell id="state" value="Server state · core/runtime.py lifespan" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=15;fillColor=#f8fafc;strokeColor=#94a3b8;shape=swimlane;startSize=36;horizontal=1;align=left;spacingLeft=16;fontStyle=1;collapsible=0;pointerEvents=0;swimlaneFillColor=#ffffff;" vertex="1" parent="runtime"><mxGeometry x="720" y="56" width="328" height="638" as="geometry" /></mxCell>
        <mxCell id="build" value="CHECKED-IN FILES · generated and verified by scripts" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=15;fillColor=#f0fdfa;strokeColor=#5eead4;shape=swimlane;startSize=36;horizontal=1;align=left;spacingLeft=16;fontStyle=1;collapsible=0;pointerEvents=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="24" y="1058" width="1072" height="176" as="geometry" /></mxCell>
        <mxCell id="client" value="&lt;b&gt;MCP client&lt;/b&gt;&lt;br&gt;Protocol 2026-07-28&lt;br&gt;or 2025-11-25" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#93c5fd;" vertex="1" parent="runtime"><mxGeometry x="24" y="56" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="http" value="&lt;b&gt;Streamable HTTP · 127.0.0.1:8000&lt;/b&gt;&lt;br&gt;POST /mcp · Host / Origin allowlists (421 / 403)&lt;br&gt;GET /health → status and version" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#dbeafe;strokeColor=#3b82f6;" vertex="1" parent="runtime"><mxGeometry x="272" y="56" width="416" height="80" as="geometry" /></mxCell>
        <mxCell id="middleware" value="&lt;b&gt;Middleware · app/middleware.py, outermost first&lt;/b&gt;&lt;br&gt;Access log → rate limit → compact schemas → usage metrics → error recovery" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#dbeafe;strokeColor=#3b82f6;" vertex="1" parent="server"><mxGeometry x="20" y="52" width="624" height="64" as="geometry" /></mxCell>
        <mxCell id="tools" value="&lt;b&gt;Tools · tools/&lt;/b&gt;&lt;br&gt;13 read-only + 2 opt-in&lt;br&gt;Markdown + structuredContent&lt;br&gt;Elicitation · progress&lt;br&gt;3 can run as background tasks" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#e0f2fe;strokeColor=#38bdf8;" vertex="1" parent="server"><mxGeometry x="20" y="140" width="232" height="118" as="geometry" /></mxCell>
        <mxCell id="resources" value="&lt;b&gt;Resources&lt;/b&gt;&lt;br&gt;4 static · 4 templates&lt;br&gt;opendart:// URIs&lt;br&gt;3 ui:// MCP App views" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#e0f2fe;strokeColor=#38bdf8;" vertex="1" parent="server"><mxGeometry x="264" y="140" width="184" height="118" as="geometry" /></mxCell>
        <mxCell id="prompts" value="&lt;b&gt;Prompts&lt;/b&gt;&lt;br&gt;11 workflow prompts&lt;br&gt;Argument completions&lt;br&gt;from the directory" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#e0f2fe;strokeColor=#38bdf8;" vertex="1" parent="server"><mxGeometry x="460" y="140" width="184" height="118" as="geometry" /></mxCell>
        <mxCell id="services" value="&lt;b&gt;Services · services/&lt;/b&gt;&lt;br&gt;Resolve the company and period, fan out reads, normalize into output models&lt;br&gt;Pure layers: events/ · registry/ · company, period, and filing logic in opendart-analysis&lt;br&gt;Results: models/ (structured) · render/ (Markdown)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#dbeafe;strokeColor=#3b82f6;" vertex="1" parent="runtime"><mxGeometry x="24" y="470" width="664" height="96" as="geometry" /></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Gateway · core/gateway.py&lt;/b&gt;&lt;br&gt;TTL cache bounded by records (LRU) · identical in-flight calls coalesced&lt;br&gt;At most 5 concurrent · 1 retry on transient failures, none on quota or maintenance&lt;br&gt;Instructive errors · requests counted per KST day" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#dbeafe;strokeColor=#3b82f6;" vertex="1" parent="runtime"><mxGeometry x="24" y="598" width="664" height="96" as="geometry" /></mxCell>
        <mxCell id="settings" value="&lt;b&gt;Settings · settings.py&lt;/b&gt;&lt;br&gt;OPENDART_MCP_* in 6 groups&lt;br&gt;API key: OPENDART_API__API_KEY&lt;br&gt;Validated at startup" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="state"><mxGeometry x="16" y="52" width="296" height="96" as="geometry" /></mxCell>
        <mxCell id="tasks" value="&lt;b&gt;Background tasks&lt;/b&gt;&lt;br&gt;fastmcp-tasks, in-memory queue&lt;br&gt;4 run at once by default" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="state"><mxGeometry x="16" y="170" width="296" height="96" as="geometry" /></mxCell>
        <mxCell id="usage" value="&lt;b&gt;Usage and logs&lt;/b&gt;&lt;br&gt;Per-component counters&lt;br&gt;→ opendart://server/status&lt;br&gt;API key redacted from logs" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="state"><mxGeometry x="16" y="288" width="296" height="96" as="geometry" /></mxCell>
        <mxCell id="directory" value="&lt;b&gt;Company directory&lt;/b&gt;&lt;br&gt;corpCode archive, background load&lt;br&gt;Disk cache, refreshed daily&lt;br&gt;Name resolution + completions" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="state"><mxGeometry x="16" y="406" width="296" height="96" as="geometry" /></mxCell>
        <mxCell id="documents" value="&lt;b&gt;Document store · opendart-analysis&lt;/b&gt;&lt;br&gt;DocumentStore with the SDK download client&lt;br&gt;One download + parse per filing, LRU cache&lt;br&gt;read_filing + filing resources" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="state"><mxGeometry x="16" y="524" width="296" height="96" as="geometry" /></mxCell>
        <mxCell id="sdk" value="&lt;b&gt;opendart-sdk · OpenDART clients&lt;/b&gt;&lt;br&gt;JSON client for gateway calls · download client for the directory and filings" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#dbeafe;strokeColor=#3b82f6;" vertex="1" parent="runtime"><mxGeometry x="24" y="726" width="664" height="72" as="geometry" /></mxCell>
        <mxCell id="api" value="&lt;b&gt;FSS English API&lt;/b&gt;&lt;br&gt;HTTPS /engapi · 82 JSON services · 3 ZIP downloads · daily request quota" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#dcfce7;strokeColor=#22c55e;" vertex="1" parent="runtime"><mxGeometry x="24" y="830" width="664" height="64" as="geometry" /></mxCell>
        <mxCell id="analysis" value="&lt;b&gt;opendart-analysis · packages/analysis&lt;/b&gt;&lt;br&gt;documents/ · parse, search, and render filings&lt;br&gt;DocumentStore · preliminary earnings&lt;br&gt;domain/ · corp-code directory parsing, matching,&lt;br&gt;resolution, identifiers, dates, periods,&lt;br&gt;categories, units, normalization&lt;br&gt;directory/ · public company lookup&lt;br&gt;Imports neither the SDK nor MCP" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#1e293b;strokeWidth=1.5;spacing=12;fontSize=13;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="runtime"><mxGeometry x="720" y="726" width="328" height="168" as="geometry" /></mxCell>
