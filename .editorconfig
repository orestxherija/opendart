# All standard properties from https://spec.editorconfig.org/#supported-pairs
# are explicit here; otherwise unspecified values depend on the editor.
root = true

[*]
indent_style = space
indent_size = 4
# Explicit even though EditorConfig normally inherits indent_size.
tab_width = 4
end_of_line = lf
charset = utf-8
spelling_language = en-US
trim_trailing_whitespace = true
insert_final_newline = true
# Supported extension, also used by the LangChain example; not a core property.
max_line_length = 120

# Match Ruff's Python formatting, including type stubs and Python GUI scripts.
[*.{py,pyi,pyw}]
max_line_length = 100

# Match JSON normalization, YAML linting, and existing reference/shell scripts.
[*.{json,json5,jsonc,yaml,yml,js,cjs,mjs,html,css,sh}]
indent_size = 2
tab_width = 2

# Taplo uses four spaces for other TOML files and two for package manifests.
[pyproject.toml]
indent_size = 2
tab_width = 2

# Keep Markdown hard line breaks, as the trailing-whitespace hook does.
[*.{md,mdx}]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = false

# Notebook output can contain meaningful whitespace and long serialized data.
[*.ipynb]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = false
max_line_length = unset

# Make recipes require tabs; Just recipes inherit the four-space defaults.
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

# Vendored conventions keep their own editor settings, like their format hooks.
[.agents/plugins/python-conventions/**]
indent_style = unset
indent_size = unset
tab_width = unset
end_of_line = unset
charset = unset
spelling_language = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
max_line_length = unset
