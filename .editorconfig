root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
spelling_language = en-US
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{py,pyi,pyw}]
max_line_length = 100

[*.{json,json5,jsonc,yaml,yml,js,cjs,mjs,html,css,sh}]
indent_size = 2
tab_width = 2

[{*.sh,.envrc}]
indent_size = 2
tab_width = 2
switch_case_indent = true

[pyproject.toml]
indent_size = 2
tab_width = 2

[*.{md,mdx}]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = false

[*.ipynb]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = false
max_line_length = unset

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

[.agents/plugins/python-conventions/**]
indent_style = unset
indent_size = unset
tab_width = unset
end_of_line = unset
charset = unset
spelling_language = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
max_line_length = unset
